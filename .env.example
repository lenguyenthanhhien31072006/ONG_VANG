MSSQL_DATABASE=mini_ong_vang_design_v1
# Set a private strong SQL Server password (upper/lowercase, digits and symbols).
MSSQL_SA_PASSWORD=
DEMO_SEED=false
# Set a local password before enabling DEMO_SEED. Only a bcrypt hash is stored.
DEMO_PASSWORD=
ROUTE_PROVIDER=fake
ROUTE_MAX_DISTANCE_KM=30
# Only needed when ROUTE_PROVIDER=goong (keep the key in your untracked .env).
GOONG_API_KEY=
GOONG_TIMEOUT_MS=5000
GOONG_VEHICLE=car
# VNPay Sandbox only. Keep credentials in untracked .env.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Public HTTPS URL served by backend, e.g. https://your-tunnel.ngrok-free.dev/api/payments/vnpay/return
VNPAY_RETURN_URL=
# Optional server IP sent in QueryDr requests; default 127.0.0.1 for local tests.
VNPAY_QUERY_IP=
